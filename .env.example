# Личные настройки image-gen. setup.py создаёт ~/.config/media-skills/image-gen.env (chmod 600).
# Ключ: api2.laozhang.ai/token (группа default).
LAOZHANG_API_KEY=
# Официальный OpenAI (необязательно): --provider openai и автопереход, когда у laozhang лежат линии 2.5.
# Ключ: platform.openai.com/api-keys.
OPENAI_API_KEY=
# Провайдер по умолчанию: laozhang (если пусто), openai или codex (подписка ChatGPT через `codex login`, без ключей).
# IMAGE_GEN_PROVIDER=codex
# Видео из картинки (необязательно): токены групп SeeDance2 и Wan с оплатой по объёму (pay-as-you-go).
LAOZHANG_SEEDANCE_API_KEY=
LAOZHANG_WAN_API_KEY=
# Своя публичная https-папка для временных кадров видео-моделей (необязательно, см. references/video.md):
# IMAGE_GEN_PUBLIC_DIR=/absolute/path/to/public/_gen
# IMAGE_GEN_PUBLIC_URL=https://media.example.com/_gen/
# Свои папки архива и кэша (по умолчанию ~/.local/share/image-gen и ~/.cache/image-gen):
# IMAGE_GEN_DATA_DIR=
# IMAGE_GEN_CACHE_DIR=
